# Each app has its own template:
#   apps/web/.env.example     -> apps/web/.env.local
#   apps/mobile/.env.example  -> apps/mobile/.env.local
#
# Root-level variables used by scripts:

# Seed script target (local Supabase by default). Never point at production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase CLI: OAuth provider secrets for the local stack (see supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
